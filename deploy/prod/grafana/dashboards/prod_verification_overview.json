{
  "dashboard": {
    "title": "PROD Verification Overview",
    "panels": [
      {
        "title": "Verification Pass Rate",
        "type": "stat",
        "targets": [{"expr": "eitp_prod_verification_pass_rate"}]
      },
      {
        "title": "Verification Total by Item",
        "type": "table",
        "targets": [{"expr": "eitp_prod_verification_total"}]
      },
      {
        "title": "Verification Duration",
        "type": "graph",
        "targets": [{"expr": "eitp_prod_verification_duration_seconds"}]
      },
      {
        "title": "Evidence Storage Size",
        "type": "graph",
        "targets": [{"expr": "eitp_prod_evidence_size_bytes"}]
      },
      {
        "title": "Dossier Status",
        "type": "stat",
        "targets": [{"expr": "eitp_prod_dossier_status"}]
      }
    ]
  }
}